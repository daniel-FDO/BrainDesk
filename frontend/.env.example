# Copy to .env to override. VITE_ variables are bundled into browser code:
# only public values here — never DATABASE_URL or SECRET_KEY.

# Leave unset in development: requests go to /api and the Vite proxy forwards them.
# Set it to call FastAPI directly (the backend's CORS_ORIGINS must include this site):
# VITE_API_URL=http://127.0.0.1:8000
